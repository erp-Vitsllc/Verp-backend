# Wasabi S3-compatible object storage
S3_ENDPOINT=s3.ap-southeast-1.wasabisys.com
S3_REGION=ap-southeast-1
S3_ACCESS_KEY=your_wasabi_access_key
S3_SECRET_KEY=your_wasabi_secret_key
S3_BUCKET_NAME=verp-storage

# Zoho Books (live vendor fetch — tokens stored in data/zoho-tokens.json)
ZOHO_CLIENT_ID=your_zoho_client_id
ZOHO_CLIENT_SECRET=your_zoho_client_secret
ZOHO_REDIRECT_URI=http://localhost:5000/api/zoho/callback
ZOHO_ORGANIZATION_ID=your_zoho_books_organization_id
ZOHO_OAUTH_SCOPE=ZohoBooks.contacts.READ
# Optional regional endpoints (EU example):
# ZOHO_ACCOUNTS_BASE_URL=https://accounts.zoho.eu
# ZOHO_API_DOMAIN=https://www.zohoapis.eu
# ZOHO_BOOKS_API_BASE=https://www.zohoapis.eu/books/v3
