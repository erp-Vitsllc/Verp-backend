# Wasabi S3-compatible object storage
S3_ENDPOINT=s3.ap-southeast-1.wasabisys.com
S3_REGION=ap-southeast-1
S3_ACCESS_KEY=your_wasabi_access_key
S3_SECRET_KEY=your_wasabi_secret_key
S3_BUCKET_NAME=verp-storage

# =============================================================================
# Zoho Books OAuth (vendors, bills, vendor payments, expenses)
# Default / first org tokens: data/zoho-tokens.json (and zoho-tokens-{orgId}.json)
# Multi-Zoho: see scripts/MULTI_ZOHO_SETUP.md
# =============================================================================
#
# Setup (first / default Zoho):
# 1. Zoho API Console → https://api-console.zoho.com/ → Server-based Application
# 2. Authorized Redirect URI must match ZOHO_REDIRECT_URI exactly
# 3. Copy Client ID + Client Secret into the vars below
# 4. Zoho Books → Settings → Organization → copy Organization ID → ZOHO_ORGANIZATION_ID
# 5. Put values in real .env (never commit secrets)
# 6. GET /api/zoho/auth-url?organizationId=<ORG_ID> (auth required) → approve
#
# Second Zoho (e.g. NNIT):
# - Same Client ID/Secret/Redirect (same API app) if both orgs are under that Zoho account
# - OR a second API client if the second Books org is under another Zoho login
# - Set Company.zohoOrganizationId = that org's ID in Mongo / company update API
# - Connect: GET /api/zoho/auth-url?organizationId=<SECOND_ORG_ID>
# - API calls: add ?organizationId=... or ?companyId=... to /api/zoho/* routes
#
# Region tip:
#   UAE / US / global often use accounts.zoho.com + www.zohoapis.com
#   EU uses accounts.zoho.eu + www.zohoapis.eu (uncomment optional block)
#
ZOHO_CLIENT_ID=your_zoho_client_id
ZOHO_CLIENT_SECRET=your_zoho_client_secret
ZOHO_REDIRECT_URI=http://localhost:5000/api/zoho/callback
# Default Zoho Books org (VEGA)
ZOHO_ORGANIZATION_ID=your_zoho_books_organization_id
# Second Zoho Books org (NNIT / Neuron Nexus) — optional; also auto-discovered from Zoho /organizations
ZOHO_ORGANIZATION_ID_NNIT=your_nnit_zoho_books_organization_id

# Scopes required by VERP (contacts, bills, vendor payments, expenses, accounts, settings)
# Must also be enabled on the Zoho API client / consent screen
# Optional: add ZohoBooks.banking.READ to enrich Paid Through from /bankaccounts
ZOHO_OAUTH_SCOPE=ZohoBooks.contacts.READ,ZohoBooks.contacts.CREATE,ZohoBooks.vendorpayments.READ,ZohoBooks.vendorpayments.CREATE,ZohoBooks.vendorpayments.UPDATE,ZohoBooks.bills.READ,ZohoBooks.bills.CREATE,ZohoBooks.bills.UPDATE,ZohoBooks.expenses.READ,ZohoBooks.expenses.CREATE,ZohoBooks.accountants.READ,ZohoBooks.settings.READ

# Optional — defaults (global). Uncomment/adjust for EU or other DCs:
# ZOHO_ACCOUNTS_BASE_URL=https://accounts.zoho.com
# ZOHO_API_DOMAIN=https://www.zohoapis.com
# ZOHO_BOOKS_API_BASE=https://www.zohoapis.com/books/v3
# EU example:
# ZOHO_ACCOUNTS_BASE_URL=https://accounts.zoho.eu
# ZOHO_API_DOMAIN=https://www.zohoapis.eu
# ZOHO_BOOKS_API_BASE=https://www.zohoapis.eu/books/v3

# Locator GPS (MyLocator Plus — token stored in data/locator-tokens.json)
LOCATOR_USERNAME=your_locator_username
LOCATOR_PASSWORD=your_locator_password
LOCATOR_IS_ADMIN=customer
# Optional overrides:
# LOCATOR_API_BASE_URL=https://pro.mylocatorplus.com/locator-clients/api
# LOCATOR_WS_BASE_URL=wss://pro.mylocatorplus.com/locator-clients/api/socket
# LOCATOR_WS_ENABLED=true
